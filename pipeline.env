# Settings for run_e2e.sh (bronze → silver → gold). Command-line options override these.
# No credentials here: S3 access comes from the EC2 instance's IAM role.

# ── S3 ───────────────────────────────────────────────────────────────────────
BUCKET=dhms-new-stgae
REGION=ap-south-1
# Raw vendor download: the s3:// folder that holds 'Zone A', 'Zone B', ... (same --root as the earlier bronze run)
RAW_S3_ROOT=s3://CHANGE-ME/raw/prefix/
# bronze → s3://$BUCKET/$BRONZE_PREFIX/bronze/nsv/zone=/phase=/cycle=/<UPC>/d1..d4/run=<time>/
BRONZE_PREFIX=nsv-extraction
# silver → s3://$BUCKET/$SILVER_PREFIX/zone=/phase=/cycle=/<UPC>/dlm_kpi|dlm_postgres|dq/
SILVER_PREFIX=nsv-silver
# gold   → s3://$BUCKET/$GOLD_PREFIX/zone=/phase=/cycle=/<UPC>/*.csv
GOLD_PREFIX=nsv-gold

# ── Reference files ──────────────────────────────────────────────────────────
# Contract-module project master (.xlsx/.csv with a UPC column). Empty = gold runs ris_trends + intermediate only.
PROJECT_MASTER_S3=
# NSV Activity Tracker for silver. Empty = CA standard / 100 m interval / survey date from the data.
TRACKER_S3=

# ── The UPC (defaults; --zone/--phase/--cycle/--upc override) ────────────────
ZONE=A
PHASE=2
CYCLE=2
UPC=N/02001/19004/DL

# Local scratch space for silver / gold (bronze reads and writes S3 directly)
WORK_DIR=$HOME/nsv_work

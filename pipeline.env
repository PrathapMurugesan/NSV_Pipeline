# Settings for run_e2e.sh (bronze → silver → gold). Command-line options override these.
# No credentials here: S3 access comes from the EC2 instance's IAM role.

# ── S3 ───────────────────────────────────────────────────────────────────────
BUCKET=dhms-new-stgae
REGION=ap-south-1
# Raw vendor download: the s3:// folder that holds 'Zone_A', 'Zone_B', ... (= $SRC of the earlier bronze runs).
# Keep the '//' after nsv-dowloads-raw: it is part of the real S3 keys.
RAW_S3_ROOT="s3://nhai-dhms-uat/nsv-dowloads-raw//unity-catalog/7474657023733156/__unitystorage/catalogs/55f24056-457d-4fa3-8b3e-37e087c38424/volumes/6fb3a2ad-d441-4118-84d9-c5b01fe405db/"
# All three layers under one folder, same layout as this repo:
#   s3://dhms-new-stgae/NSV_Pipeline/bronze/nsv/zone=/phase=/cycle=/<UPC>/d1..d4/run=<time>/
#   s3://dhms-new-stgae/NSV_Pipeline/silver/zone=/phase=/cycle=/<UPC>/dlm_kpi|dlm_postgres|dq/
#   s3://dhms-new-stgae/NSV_Pipeline/gold/zone=/phase=/cycle=/<UPC>/*.csv
#   s3://dhms-new-stgae/NSV_Pipeline/logs/e2e_<time>_<UPC>.log
# (bronze adds bronze/nsv/ itself; the earlier bronze-only runs used BRONZE_PREFIX=nsv_extraction_new -
#  never the old 'nsv-extraction', where this UPC's 'Comparison as per CA' was rejected)
PIPELINE_PREFIX=NSV_Pipeline
BRONZE_PREFIX=$PIPELINE_PREFIX
SILVER_PREFIX=$PIPELINE_PREFIX/silver
GOLD_PREFIX=$PIPELINE_PREFIX/gold

# ── Reference files ──────────────────────────────────────────────────────────
# Contract-module project master (.xlsx/.csv with a UPC column). Empty = gold runs ris_trends + intermediate only.
PROJECT_MASTER_S3=s3://dhms-new-stgae/nsv_extraction_new/master/project_master.xlsx
# NSV Activity Tracker for silver. Empty = CA standard / 100 m interval / survey date from the data.
TRACKER_S3=

# ── The UPC (defaults; --zone/--phase/--cycle/--upc override) ────────────────
ZONE=A
PHASE=2
CYCLE=2
UPC=N/02001/19004/DL

# Local scratch space for silver / gold (bronze reads and writes S3 directly)
WORK_DIR=${WORK_DIR:-$HOME/nsv_work}
